    async function uploadImageFile(f){
      if (!f || !/^image\//.test(f.type)) return;
      if (f.size > 8 * 1024 * 1024){ alert('Image exceeds 8 MB.'); return; }
      const dataUrl = await new Promise((res, rej) => { const rd = new FileReader(); rd.onload = () => res(rd.result); rd.onerror = rej; rd.readAsDataURL(f); });
      if (await jsend(`${base}/images`, 'POST', { data_url: dataUrl, filename: f.name || '' })) renderImages();
      else alert('Upload failed (image too large for the proxy, or server error).');
