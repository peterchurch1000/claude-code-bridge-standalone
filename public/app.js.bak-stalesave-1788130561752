  async function openAccountSwitcher() {
    document.querySelectorAll('.cauth-overlay').forEach(n => n.remove());
    const ov = document.createElement('div');
    ov.className = 'cauth-overlay';
    ov.innerHTML = `
      <div class="cauth-modal">
